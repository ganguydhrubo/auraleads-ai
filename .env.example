# ==========================================
# AuraLeads AI — Environment Configuration
# ==========================================
# Copy this file to .env.local for local dev. In production (Vercel), set
# each of these in Project Settings → Environment Variables instead.
# See SETUP.md for a step-by-step walkthrough of getting every value below.

PORT=3000

# --- Supabase (required for everything — auth, database, RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://tqvvqskscawuifjkaqby.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption (required for LinkedIn/Instagram browser sessions + Gmail app passwords) ---
# Generate with: openssl rand -hex 32
# Must be the SAME value here and in workers/social-worker/.env
SESSION_ENCRYPTION_KEY=

# --- Groq (required for AI hashtag/message generation + AI auto-replies) ---
GROQ_API_KEY=

# --- Meta (Instagram Graph API + WhatsApp Cloud API webhooks) ---
# One shared verify token you invent yourself and paste into both the
# Instagram and WhatsApp webhook config screens in Meta's App Dashboard.
META_VERIFY_TOKEN=auraleads_wh_token_88921
# Your Meta App's secret (App Dashboard → Settings → Basic) — used to verify
# the HMAC signature on both the Instagram and WhatsApp webhooks.
META_APP_SECRET=

# --- PayPal (real Orders v2 checkout) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" for real charges, anything else (or unset) uses the sandbox
PAYPAL_ENV=sandbox

# Note: WhatsApp, X, LinkedIn-automation and Instagram-automation credentials
# are NOT set here — they're pasted directly into Settings inside the app
# (per-workspace, stored encrypted or verified live), not as server env vars.
